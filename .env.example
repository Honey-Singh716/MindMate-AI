GROQ_API_KEY=your_groq_api_key
# Optional: a preferred default model. If set, it is used only when it is present
# among the models Groq reports as currently available; otherwise the first
# available chat-capable model is used. Model IDs are never hardcoded in code.
GROQ_MODEL=
# How long (ms) the server caches the Groq model list before refreshing it.
# Default: 900000 (15 minutes). Lower = more dynamic, more API calls.
MODELS_CACHE_TTL_MS=900000
DATABASE_URL=postgresql://username:password@localhost:5432/mindmate
JWT_SECRET=replace_with_a_long_random_secret
NODE_ENV=development

# --- RAG / embeddings ---
# Provider used to embed document chunks and chat questions.
# "local" -> transformers.js + all-MiniLM-L6-v2 (free, runs in Node, downloads a
#            ~25MB model on first use). Requires `npm install @xenova/transformers`.
# "mock"  -> deterministic hash vectors, no download/API key. NOT semantic; useful
#            to test the RAG pipeline offline without any model download.
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=384
# PostgreSQL is reused for storage (no new database). pgvector is auto-detected at
# startup: if installed, embeddings use a vector(N) column + cosine search; if not,
# a JSONB fallback with Node-side cosine ranking is used (fine for resume-scale data).

